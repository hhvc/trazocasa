# Google Drive (public browser configuration; NEVER add a client secret or token)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
# Numeric Google Cloud project number, not the project ID
VITE_GOOGLE_APP_ID=

# Optional features: disabled by default; no billing or payment service is created.
VITE_ENABLE_GOOGLE_DRIVE=false
# Public HTTPS payment/support link. Empty hides the donation action.
VITE_DONATION_URL=https://link.mercadopago.com.ar/trazocasa
